# mock: deterministic local responses; api: OpenAI-compatible model endpoint.
LAB_MODEL_MODE=mock
LAB_PREFIX=lang-tools-lab
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=local-demo
LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
LLM_TIMEOUT=60
# Includes reasoning tokens on models that use them; ktcloud Qwen example uses 2048.
LLM_MAX_TOKENS=512

# LangSmith: use a personal test project and its region's endpoint.
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=lang-tools-lab
# Set LANGSMITH_WORKSPACE_ID if your key needs an explicit workspace.
LANGSMITH_WORKSPACE_ID=

# Langfuse SDK 5 needs server >=4.59.0 (Cloud or the included local setup).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_TRACING_ENVIRONMENT=lab
